{"name":"@leviro-ai/secret-coverage","version":"0.1.11","description":"Environment Secret Coverage Checker: detect missing environment variables before deployment fails.","type":"module","bin":{"secret-coverage":"dist/cli.js","seccov":"dist/cli.js"},"files":["dist","action.yml","README.md"],"scripts":{"build":"tsc -p tsconfig.json","typecheck":"tsc -p tsconfig.json --noEmit","lint":"pnpm typecheck","test":"vitest run","test:watch":"vitest","security:audit":"pnpm audit --audit-level moderate","package:check":"npm pack --dry-run","quality":"pnpm lint && pnpm test && pnpm build && pnpm security:audit && pnpm package:check","scan":"tsx src/cli.ts scan"},"dependencies":{"commander":"^12.1.0","fast-glob":"^3.3.3","yaml":"^2.6.1"},"devDependencies":{"@types/node":"^22.10.2","tsx":"^4.19.2","typescript":"^5.7.2","vite":"^8.0.14","vitest":"^4.1.7"},"engines":{"node":">=20"},"keywords":["env","environment-variables","ci","deployment","github-actions","vercel","docker","nextjs","secret-coverage","environment-secret-coverage","secrets","deployment-readiness"],"license":"Apache-2.0","author":"Leviro AI","repository":{"type":"git","url":"git+https://github.com/leviro-ai/secret-coverage.git"},"bugs":{"url":"https://github.com/leviro-ai/secret-coverage/issues"},"homepage":"https://github.com/leviro-ai/secret-coverage#readme"}